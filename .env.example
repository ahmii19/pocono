DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pocono?schema=public"

# ─── SMTP / EMAIL ────────────────────────────────────────────────
# Use Gmail SMTP with an App Password (NOT your regular Gmail password).
# Generate App Password at: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pocono Vacations <no-reply@pocono.vacations>

# ─── APP ─────────────────────────────────────────────────────────
ADMIN_EMAIL=
FRONTEND_URL=http://localhost:3000
