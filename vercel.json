{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/**",
          "prisma/schema.prisma",
          "node_modules/.prisma/client/**",
          "server/src/data/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "/api/index.js" },
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/uploads/(.*)", "dest": "/api/index.js" },
    { "src": "/wp-content/uploads/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}
